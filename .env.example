APP_NAME=Scanner API
APP_VERSION=1.0.0
DEBUG=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# true — если перед БД стоит pgbouncer в transaction-режиме (KZ)
# false — прямое подключение к Postgres
DB_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_DAYS=300
JWT_ALGORITHM=HS256
JWT_ISSUER=besoft:sxodim

STORAGE_URL=https://api.sxodim.uz/storage/images/

DEFAULT_COUNTRY_CODE=uz
DEFAULT_COUNTRY_ID=1
TIME_ZONE_DIFFERENCE=5

# true — только после добавления в базу колонок user_permissions.scan_zone
# и scan_logs.payload (SQL — в README, раздел «Зоны сканирования»)
SCAN_ZONE_COLUMNS=false
# сколько секунд держать в памяти счётчики сеанса и учётку контролёра (0 — не держать)
COUNTS_CACHE_TTL=3
AUTH_CACHE_TTL=30
